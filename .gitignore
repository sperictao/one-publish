# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
release-assets/
/src-tauri/target/
/target/
# vendored crates keep their own cargo metadata when built in isolation
/src-tauri/vendor/*/target/
/src-tauri/vendor/*/Cargo.lock
/crates/publish-runner-core/tests/samples/*/target/
/crates/publish-runner-core/tests/samples/*/obj/
/crates/publish-runner-core/tests/samples/*/bin/

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and local overrides
.env
.env.*
*.local
!.env.example
!.env.*.example

# Signing keys, certificates, and SSH material must never be committed.
# Release signing arrives via CI secrets/keychain, not repository files.
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*

# TypeScript and tool caches
*.tsbuildinfo
.cache/
.eslintcache
.prettiercache
.vite/
__pycache__/
*.py[cod]

# Test outputs
coverage/
playwright-report/
test-results/

# Editor and IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS metadata
.DS_Store
Thumbs.db

# Tauri local/generated outputs
src-tauri/tauri.conf.updater.prod.json

# Local agent workspace metadata
/config.json
/events.jsonl
/labels/
/statuses/
/views.json
/repo-list-empty.png

# AI agent / tool workspaces
/.agents/
/.claude/
/.claude-plugin/
/.codex/
/.cursor/
/.opencode/
/.pi/
/.trellis/
/.workflow/
/.sc/
/.ace-tool/
/.pnpm-store/
/plans/
/scratch/
/CLAUDE.md
/branch-title.json
/.zcode/

# Autoresearch local state
/autoresearch-*.json
/autoresearch-*.log
/autoresearch-*.md
/research-results*.tsv

# Other local agent state
/.ob1/
/.omc/
/.workbuddy/
/src-tauri/.omc/
/.mindfs/

# Untracked doc artifacts (generated/report outputs, not source)
/docs/archify/
/docs/architecture.mmd
/docs/architecture.png
/docs/architecture.svg
# docs/agent/ (singular) is a divergent ad-hoc report dir; keep docs/agents/ (plural, tracked)
/docs/agent/

# UI/UX audit workspace (recording specs, screenshots, self-contained reports — local evidence only)
/.ui-audit/
coverage-rust/
