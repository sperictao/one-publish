{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-mini-app",
  "version": "0.1.0",
  "identifier": "com.example.tauri-mini-app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tauri-mini-app",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
