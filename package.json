{
  "name": "one-publish",
  "version": "1.0.3",
  "description": "Cross-platform .NET publish tool with GUI",
  "type": "module",
  "scripts": {
    "dev": "pnpm tauri dev",
    "build": "pnpm tauri build",
    "build:updater": "node scripts/build-updater.mjs",
    "generate:contracts": "cargo run --manifest-path src-tauri/Cargo.toml --example generate_tauri_contracts",
    "generate:icons": "node scripts/generate-icons.mjs && node scripts/generate-tray-icons.mjs",
    "check:contracts": "node scripts/check-tauri-contracts.mjs",
    "release": "node scripts/release.mjs",
    "tauri": "tauri",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "typecheck": "pnpm check:contracts && tsc --noEmit",
    "test:workflow": "node scripts/test-build-release-workflow.mjs",
    "test:updater": "node scripts/test-updater-scripts.mjs",
    "test:release": "node scripts/test-release-script.mjs",
    "check:i18n": "node scripts/check-i18n-coverage.mjs",
    "check:design": "node scripts/check-geist-compliance.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "doctor": "react-doctor",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "~2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "^4.1.12",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "30.1.3",
    "lint-staged": "^17.6.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.10",
    "react-doctor": "^0.9.18",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-dialog": "~2.8.3",
    "@tauri-apps/plugin-log": "~2.10.1",
    "@tauri-apps/plugin-process": "~2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.60.0",
    "non.geist": "^2.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "packageManager": "pnpm@10.10.0",
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,md,mdx,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
